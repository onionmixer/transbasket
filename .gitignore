# ---- Build artifacts ----
/obj/
/transbasket
/cache_tool

# ---- Debug traces ----
/trace/

# ---- Editor / swap / temp ----
*.swp
*.swo
*~

# ---- Backups ----
*.backup

# ---- Runtime translation caches (SQLite + WAL/SHM sidecars) ----
*.db
*.db-wal
*.db-shm

# ---- Per-environment caches and codex per-request run dirs ----
# Created at runtime by run_dkfs_codex.sh / run_pge4_codex.sh (mkdir -p).
/caches/
/codex_run/

# ---- Text-backend cache / dictionaries (runtime data) ----
/trans_dictionary*.txt
/migrated_back.txt

# ---- Per-environment (dkfs/pge4) codex run configs & launch scripts ----
# Deployment-specific; the generic transbasket_codex.conf template stays tracked.
/transbasket_dkfs_codex.conf
/transbasket_pge4_codex.conf
/run_dkfs_codex.sh
/run_pge4_codex.sh

# ---- Agent / editor local settings ----
# Currently only excluded by the developer's global gitignore, so a clone on
# another machine would commit it. Keep it out of the repo explicitly.
.claude/settings.local.json
.vscode/
.idea/
.DS_Store

# ---- Secrets ----
.env
.env.*
*.pem
*.key

# ---- Extra build / debug artifacts ----
# `make debug` and ad-hoc symbol builds land in the project root.
*.o
*.a
*.so
/transbasket_g
/transbasket_dbg
core
core.*
vgcore.*

# ---- Ad-hoc test configs ----
# Throwaway copies used while testing (different port, separate cache DB).
# The tracked templates are transbasket.conf / transbasket_codex.conf /
# transbasket_example_cache_*.conf.
*_test.conf
*_impl.conf

# ---- Run logs ----
*.log
nohup.out

# ---- SQLite rollback journal (non-WAL mode) ----
*.db-journal

# ---- Python (tests/test_client.py) ----
__pycache__/
*.py[cod]
venv/
.venv/

# ---- Patch leftovers ----
*.orig
*.rej
